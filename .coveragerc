# Cobertura para la suite de pruebas y para SonarQube.
[run]
branch = False
source = .
# Rutas relativas en el XML: imprescindible cuando el analisis lo hace el
# scanner en un contenedor Linux (si no, SonarQube no sabe mapear rutas
# tipo C:\...\proyecto y avisa de "Invalid directory path in 'source'").
relative_files = True
omit =
    venv/*
    .venv/*
    env/*
    tests/*
    scripts/*
    datos/*
    proyectos/*
    plantillas.py
    IA COLABORATIVA.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
show_missing = True
skip_covered = False

[xml]
output = coverage.xml
