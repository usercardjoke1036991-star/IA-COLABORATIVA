# ============================================================================
# ARQUITECTO EXTERNO - ejemplo de configuracion
# ----------------------------------------------------------------------------
# Copia este archivo como ".env" en la misma carpeta y rellena tu clave:
#     copy .env.example .env        (Windows PowerShell / CMD)
#     cp .env.example .env          (macOS / Linux)
#
# El archivo ".env" esta en .gitignore: NUNCA sube tus claves a un repositorio.
# ============================================================================

# --- Proveedor --------------------------------------------------------------
# deepseek | openrouter | openai | custom | mock
#   deepseek   -> DeepSeek oficial (deepseek-chat / deepseek-reasoner)
#   openrouter -> cientos de modelos con una sola clave
#   openai     -> endpoints oficiales de OpenAI
#   custom     -> cualquier endpoint compatible con /chat/completions
#                 (Ollama, LM Studio, vLLM, Azure, Groq...)
ARQUITECTO_PROVIDER=deepseek

# --- Credencial del proveedor elegido --------------------------------------
# Rellena SOLO la del proveedor que uses (las demas pueden quedar vacias).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Modelo -----------------------------------------------------------------
# Si lo dejas comentado se usa el modelo por defecto de cada proveedor.
# Ejemplos:
#   ARQUITECTO_MODEL=deepseek-chat
#   ARQUITECTO_MODEL=deepseek-reasoner
#   ARQUITECTO_MODEL=anthropic/claude-3.5-sonnet
#   ARQUITECTO_MODEL=gpt-4o
ARQUITECTO_MODEL=

# --- Solo para ARQUITECTO_PROVIDER=custom ----------------------------------
# Ejemplos:
#   ARQUITECTO_API_URL=http://127.0.0.1:11434/v1/chat/completions   (Ollama)
#   ARQUITECTO_API_URL=http://127.0.0.1:1234/v1/chat/completions    (LM Studio)
ARQUITECTO_API_URL=
ARQUITECTO_API_KEY=

# --- Comportamiento ---------------------------------------------------------
# Creatividad del arquitecto: bajo = mas determinista y tecnico (def. 0.4).
ARQUITECTO_TEMPERATURA=0.4
# Segundos maximos por peticion antes de abortar (def. 120).
ARQUITECTO_TIMEOUT=120
# Tokens maximos de cada respuesta del arquitecto (def. 4096).
ARQUITECTO_MAX_TOKENS=4096
# Reintentos ante error de red, 429 o 5xx (def. 2).
ARQUITECTO_REINTENTOS=2

# --- Memoria del loop -------------------------------------------------------
# Pares pregunta/respuesta que se conservan en el contexto (def. 12).
ARQUITECTO_MAX_TURNOS=12
# Tope de caracteres enviados al modelo por peticion (def. 24000).
ARQUITECTO_MAX_CARACTERES=24000
# Guardar el historial en datos/historial_arquitecto.json (def. true).
ARQUITECTO_PERSISTIR=true

# --- Diagnostico ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR  (los logs van a stderr, nunca a stdout).
ARQUITECTO_LOG=INFO
# Opcional: URL publica de tu proyecto; OpenRouter la usa como HTTP-Referer.
ARQUITECTO_APP_URL=

# --- Modo simulado ----------------------------------------------------------
# true = no llama a ninguna API; respuestas simuladas para probar la mecanica.
ARQUITECTO_MOCK=false
# Informes de progreso que acepta el simulador antes de declarar FIN (def. 2).
ARQUITECTO_MOCK_TURNOS=2

# --- Modo HTTP opcional (solo con: python arquitecto_mcp.py --http) ---------
ARQUITECTO_HTTP_HOST=127.0.0.1
ARQUITECTO_HTTP_PORT=8765

# ============================================================================
# ROL PROGRAMADOR (segundo modelo: el que escribe el codigo)
# ----------------------------------------------------------------------------
# El ARQUITECTO razona con un modelo fuerte y el PROGRAMADOR escribe con uno
# rapido y barato. Esta es la combinacion que mejor rinde en DeepSeek:
#   ARQUITECTO_MODEL=deepseek-reasoner      (planifica: R1, razona)
#   ARQUITECTO_EJECUTOR_MODEL=deepseek-chat (escribe: V3, rapido)
# Si dejas una variable vacia, se hereda la del arquitecto.
# ============================================================================
ARQUITECTO_EJECUTOR_PROVIDER=
ARQUITECTO_EJECUTOR_MODEL=deepseek-chat
ARQUITECTO_EJECUTOR_API_KEY=
ARQUITECTO_EJECUTOR_API_URL=
# El programador conviene que sea mas determinista que el arquitecto.
ARQUITECTO_EJECUTOR_TEMPERATURA=0.2
# Escribe archivos completos: suele necesitar mas tokens de salida.
ARQUITECTO_EJECUTOR_MAX_TOKENS=8192
ARQUITECTO_EJECUTOR_TIMEOUT=600
# Vacio = hereda ARQUITECTO_MOCK.
ARQUITECTO_EJECUTOR_MOCK=

# ============================================================================
# FABRICA DE PROYECTOS
# ----------------------------------------------------------------------------
# Cada idea vive en su propia carpeta con su propio git, dentro de la raiz de
# proyectos. La fabrica NO escribe fuera de ahi (salvo permiso explicito).
# ============================================================================
# Carpeta raiz de los proyectos (relativa a este repo o absoluta).
ARQUITECTO_CARPETA_PROYECTOS=proyectos
# Ruta del registro de proyectos (vacio = datos/proyectos.json).
ARQUITECTO_REGISTRO=
# true = permite escribir en cualquier ruta absoluta. PELIGROSO: dejalo false.
ARQUITECTO_PERMITIR_EXTERNO=false
# Plantillas por defecto al crear un proyecto (claves de plantillas.py).
# Se pueden combinar: python, flask, fastapi, web3, playwright, mcp, vacio.
ARQUITECTO_PLANTILLAS=python
# true = crear_proyecto crea tambien el venv (sin instalar dependencias).
# false (recomendado) = creacion instantanea; el venv lo hace `preparar_entorno`.
ARQUITECTO_CREAR_VENV=false

# --- Identidad de los commits de la fabrica --------------------------------
# Si los dejas vacios se usa la configuracion global de git.
ARQUITECTO_GIT_USUARIO=
ARQUITECTO_GIT_EMAIL=

# --- Publicacion en GitHub (requiere GitHub CLI: gh auth login) ------------
ARQUITECTO_GITHUB=false
# private | public
ARQUITECTO_GITHUB_VISOR=private
# Usuario u organizacion destino (vacio = la cuenta autenticada en gh).
ARQUITECTO_GITHUB_ORG=

# ============================================================================
# ORQUESTADOR AUTONOMO (python orquestador.py --idea "...")
# ----------------------------------------------------------------------------
# interno = los dos modelos externos trabajan solos (recomendado).
# cline   = cada turno se delega a Cline CLI en el terminal.
# ============================================================================
ARQUITECTO_ORQUESTADOR=interno
ARQUITECTO_CLINE_COMANDO=cline
# true = pasa --auto-approve true a Cline CLI (menos interrupciones).
ARQUITECTO_CLINE_AUTO=true
# Rondas maximas del orquestador antes de detenerse.
ARQUITECTO_LIMITE_TURNOS=6

